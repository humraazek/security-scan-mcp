# security-scan-mcp Environment Configuration

# Network interface to bind (127.0.0.1 for local machine, 0.0.0.0 for Docker container)
HOST=127.0.0.1

# HTTP port for the MCP SSE transport server
PORT=8932

# Optional authentication token for securing the MCP endpoint (Bearer token or ?token=)
# Leave empty to allow unauthenticated localhost connections
AUTH_TOKEN=

# SSRF Protection: set to "1" or "true" only if you explicitly need to scan local or private targets
# Keep "false" (default) when testing public web applications
ALLOW_PRIVATE_TARGETS=false

# Timeout in milliseconds for probe requests
FETCH_TIMEOUT_MS=7000

# Maximum response body size in bytes to buffer per probe (prevents memory exhaustion)
MAX_RESPONSE_BYTES=1048576

# Optional comma-separated list of allowed browser origins for cross-origin requests
ALLOWED_ORIGINS=
